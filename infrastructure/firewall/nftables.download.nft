#!/usr/sbin/nft -f
# TITAN AI — DOWNLOAD MODE (DNS + HTTP/HTTPS outbound)
flush ruleset

table inet titan {
    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iif "lo" accept
        # TITAN services bind to loopback only; no inbound needed.
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy drop;
        ct state established,related accept
        oif "lo" accept
        # Download mode: DNS + HTTP/HTTPS only, logged.
        udp dport 53 accept
        tcp dport 53 accept
        tcp dport { 80, 443 } accept
        counter log prefix "titan-egress-drop " drop
    }
}
